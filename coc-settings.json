{
    "suggest.completionItemKindLabels": {
        "keyword": "\uf1de",
        "variable": "\ue79b",
        "value": "\uf89f",
        "operator": "\u03a8",
        "constructor": "\uf0ad",
        "function": "\u0192",
        "reference": "\ufa46",
        "constant": "\uf8fe",
        "method": "\uf09a",
        "struct": "\ufb44",
        "class": "\uf0e8",
        "interface": "\uf417",
        "text": "\ue612",
        "enum": "\uf435",
        "enumMember": "\uf02b",
        "module": "\uf40d",
        "color": "\ue22b",
        "property": "\ue624",
        "field": "\uf9be",
        "unit": "\uf475",
        "event": "\ufacd",
        "file": "\uf723",
        "folder": "\uf114",
        "snippet": "\ue60b",
        "typeParameter": "\uf728",
        "default": "\uf29c"
    },
    "languageserver": {
        "ccls": {
            "command": "ccls",
            "filetypes": [
                "c",
                "cpp",
                "cuda",
                "objc",
                "objcpp"
            ],
            "rootPatterns": [
                ".ccls",
                "compile_commands.json"
            ],
            "initializationOptions": {
                "cache": {
                    "directory": ".ccls-cache",
                    "format": "binary"
                },
                "client": {
                    "snippetSupport": true
                },
                "index": {
                    "onChange": true
                },
                "highlight": {
                    "lsRanges": true
                }
            }
        },
        "cmake": {
            "command": "cmake-language-server",
            "filetypes": [
                "cmake"
            ],
            "rootPatterns": [
                "build/"
            ],
            "initializationOptions": {
                "buildDirectory": "build"
            }
        }
    },
    "semanticTokens.enable": true,
    "[python]": {
        "inlayHint.enable": false,
        "inlayHint.enableParameter": false,
        "inlayHint.display": false
    },
    "jedi.enable": true,
    "jedi.startupMessage": false,
    "jedi.diagnostics.enable": true,
    "jedi.completion.resolveEagerly": true,
    "ruff.enable": true,
    "ruff.nativeServer": true,
    "ruff.disableDocumentFormatting": false,
    "ruff.lint.enable": true,
    "ruff.lint.run": "onType",
    "ruff.lint.extendSelect": [
        "N"
    ],
    "ruff.lineLength": 88,
    "ruff.organizeImports": true,
    "ruff.fixAll": true,
    "ruff.codeAction.fixViolation.enable": true,
    "ruff.codeAction.disableRuleComment.enable": true,
    "ruff.configurationPreference": "editorFirst",
    "ruff.showNotifications": "onError"
}
